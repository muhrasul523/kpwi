<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kontrol Kegiatan SBK</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: { brand: { blue: '#1e3a8a', gold: '#eab308' } },
                    fontFamily: { sans: ['Inter', 'sans-serif'] }
                }
            }
        }
    </script>
    
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <style>
        body { font-family: 'Inter', sans-serif; background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 50%, #ffffff 100%); min-height: 100vh; color: #1e293b; }
        .glass-panel { background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); border: 1px solid rgba(255, 255, 255, 0.6); box-shadow: 0 10px 40px rgba(30, 58, 138, 0.08); }
        .fade-in { animation: fadeIn 0.4s ease-out forwards; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(15px); } to { opacity: 1; transform: translateY(0); } }
        ::-webkit-scrollbar { width: 8px; height: 8px; }
        ::-webkit-scrollbar-track { background: #f1f5f9; border-radius: 10px; }
        ::-webkit-scrollbar-thumb { background: #94a3b8; border-radius: 10px; }
        
        /* Modal Tabs */
        .tab-btn { transition: all 0.3s; border-bottom: 2px solid transparent; }
        .tab-btn.active { color: #1e3a8a; border-bottom: 2px solid #eab308; font-weight: 700; background: rgba(30,58,138,0.05); }
    </style>
</head>
<body class="antialiased selection:bg-brand-gold selection:text-brand-blue" onload="initSystem()">

    <!-- LOADING OVERLAY -->
    <div id="loadingOverlay" class="fixed inset-0 bg-brand-blue z-[9999] flex flex-col items-center justify-center text-white transition-all duration-300">
        <i class="fa-solid fa-spinner fa-spin text-5xl text-brand-gold mb-6 drop-shadow-[0_0_15px_rgba(255,255,255,0.3)]"></i>
        <div class="w-72 max-w-[80vw] h-2.5 bg-blue-900 rounded-full overflow-hidden shadow-inner border border-blue-800">
            <div class="h-full bg-gradient-to-r from-brand-gold to-yellow-300 w-full animate-[pulse_1s_ease-in-out_infinite] shadow-[0_0_10px_rgba(234,179,8,0.8)]"></div>
        </div>
        <p class="mt-4 text-sm font-medium text-blue-200" id="loadingText">Memuat Sistem... <span id="loadingPercent">0%</span></p>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        
        <!-- HEADER -->
        <div class="text-center mb-6 fade-in hidden" id="headerLogo">
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-brand-blue text-brand-gold text-3xl mb-3 shadow-lg">
                <i class="fa-solid fa-clipboard-check"></i>
            </div>
            <h1 class="text-2xl md:text-3xl font-extrabold text-brand-blue tracking-tight">Kontrol Kegiatan SBK</h1>
            <p class="text-gray-500 mt-1 text-sm font-medium">Sistem Pengontrolan & Pelaporan Kinerja</p>
        </div>

        <!-- 1. VIEW LOGIN -->
        <div id="loginView" class="max-w-md mx-auto glass-panel rounded-2xl p-8 fade-in border-t-4 border-t-brand-blue hidden mt-10">
            <h2 class="text-xl font-bold text-center text-brand-blue mb-2"><i class="fa-solid fa-right-to-bracket mr-2 text-brand-gold"></i>Login SBK</h2>
            <p class="text-sm text-center text-gray-500 mb-6">Masukkan nomor WhatsApp Anda.</p>
            <form onsubmit="handleLogin(event)">
                <div class="mb-5">
                    <label class="block text-sm font-bold text-brand-blue mb-1.5"><i class="fa-brands fa-whatsapp text-green-500 text-base mr-1"></i> Nomor WhatsApp</label>
                    <input type="text" id="loginWa" required class="w-full rounded-xl border-gray-300 border bg-white px-3.5 py-3 focus:ring-4 focus:ring-blue-100 outline-none text-gray-700 font-medium" placeholder="Contoh: 08123456789" oninput="formatWA(this)">
                </div>
                <button type="submit" class="w-full bg-brand-blue hover:bg-blue-800 text-white font-bold py-3 px-4 rounded-xl shadow-md transition-all flex justify-center items-center gap-2">
                    Masuk <i class="fa-solid fa-arrow-right"></i>
                </button>
            </form>
        </div>

        <!-- 2. VIEW PILIH BIDANG -->
        <div id="pilihBidangView" class="max-w-md mx-auto glass-panel rounded-2xl p-8 fade-in border-t-4 border-t-brand-gold hidden mt-10">
            <h2 class="text-xl font-bold text-center text-brand-blue mb-2">Pilih Bidang Kerja</h2>
            <p class="text-sm text-center text-gray-500 mb-6" id="welcomePilihBidang">Selamat datang,</p>
            <div id="listBidang" class="space-y-3"></div>
            <button onclick="logout()" class="mt-6 w-full text-red-500 hover:text-red-700 text-sm font-medium transition-colors">
                <i class="fa-solid fa-arrow-left mr-1"></i> Batal & Kembali
            </button>
        </div>

        <!-- 3. MAIN APP VIEW (DASHBOARD KONTROL) -->
        <div id="mainAppView" class="hidden fade-in">
            
            <!-- User Info Card -->
            <div class="max-w-7xl mx-auto bg-gradient-to-r from-brand-blue to-blue-800 rounded-2xl p-5 mb-6 text-white shadow-lg flex flex-col md:flex-row justify-between items-center gap-4">
                <div class="flex items-center gap-4">
                    <div class="w-12 h-12 bg-white/20 rounded-full flex items-center justify-center border border-white/30">
                        <i class="fa-solid fa-user-tie text-2xl text-brand-gold"></i>
                    </div>
                    <div>
                        <p class="text-xs text-blue-200 font-medium uppercase tracking-wider">Akses SBK Aktif</p>
                        <h2 class="text-lg font-bold" id="infoNama">Nama User</h2>
                        <p class="text-sm text-blue-100"><i class="fa-solid fa-layer-group text-brand-gold mr-1"></i> Bidang: <span id="infoBidang" class="font-semibold"></span></p>
                    </div>
                </div>
                <div class="flex gap-2">
                    <button onclick="switchRole()" id="btnSwitchRole" class="hidden bg-white/10 hover:bg-white/20 px-4 py-2 rounded-lg text-sm font-semibold transition-colors flex items-center gap-2 border border-white/20">
                        <i class="fa-solid fa-arrow-right-arrow-left"></i> Ganti Bidang
                    </button>
                    <button onclick="logout()" class="bg-red-500 hover:bg-red-600 px-4 py-2 rounded-lg text-sm font-semibold transition-colors flex items-center gap-2 border border-red-400">
                        <i class="fa-solid fa-power-off"></i> Keluar
                    </button>
                </div>
            </div>

            <!-- TAB CONTENT: DATA TABLE -->
            <div class="max-w-7xl mx-auto glass-panel rounded-2xl p-6 border-t-4 border-t-brand-gold">
                <div class="flex flex-col md:flex-row justify-between items-center gap-4 mb-4 border-b pb-4 border-gray-200">
                    <div>
                        <h3 class="text-lg font-bold text-brand-blue flex items-center"><i class="fa-solid fa-list-check text-brand-gold mr-2"></i> Daftar Kegiatan (Perlu Dikontrol)</h3>
                        <p class="text-xs text-gray-500 mt-1">Pilih kegiatan untuk mengisi form Pra dan Pasca kegiatan.</p>
                    </div>
                    
                    <div class="relative w-full md:w-64">
                        <input type="text" id="searchTable" onkeyup="filterTableUI()" placeholder="Cari kegiatan..." class="w-full pl-9 pr-3 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-brand-blue outline-none text-sm bg-white">
                        <i class="fa-solid fa-search absolute left-3 top-2.5 text-gray-400 text-sm"></i>
                    </div>
                </div>

                <div class="overflow-x-auto rounded-xl border border-gray-200">
                    <table class="w-full text-left text-sm" id="dataTable">
                        <thead class="bg-brand-blue text-white whitespace-nowrap">
                            <tr>
                                <th class="px-4 py-3 font-semibold text-center w-12">No</th>
                                <th class="px-4 py-3 font-semibold">Nama Kegiatan</th>
                                <th class="px-4 py-3 font-semibold">Tanggal</th>
                                <th class="px-4 py-3 font-semibold">Status Kontrol</th>
                                <th class="px-4 py-3 font-semibold text-center w-28">Aksi</th>
                            </tr>
                        </thead>
                        <tbody id="tableBody" class="divide-y divide-gray-200 bg-white/60">
                            <!-- Injected by JS -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- MODAL FORM KONTROL -->
    <div id="modalKontrol" class="fixed inset-0 z-[100] hidden bg-gray-900 bg-opacity-60 flex items-center justify-center p-4 backdrop-blur-sm transition-opacity">
        <div class="bg-white rounded-2xl shadow-2xl w-full max-w-4xl max-h-[95vh] flex flex-col overflow-hidden transform scale-95 transition-transform duration-300" id="modalKontrolContent">
            
            <!-- Header Modal -->
            <div class="p-5 border-b border-gray-200 bg-gradient-to-r from-gray-50 to-white flex justify-between items-center">
                <div>
                    <h3 class="text-xl font-bold text-brand-blue flex items-center gap-2"><i class="fa-solid fa-sliders text-brand-gold"></i> Form Kontrol Kegiatan</h3>
                    <p class="text-sm font-semibold text-gray-600 mt-1" id="modalSubtitle">Nama Kegiatan</p>
                </div>
                <button onclick="closeModal()" class="text-gray-400 hover:text-red-500 bg-gray-100 hover:bg-red-50 rounded-full w-8 h-8 flex items-center justify-center transition-colors">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>
            
            <!-- Body Modal -->
            <div class="p-6 overflow-y-auto flex-1 bg-gray-50/50 custom-scrollbar">
                
                <form id="formKontrol">
                    <input type="hidden" id="idKegiatan">
                    <input type="hidden" id="namaKegiatanModal">
                    <input type="hidden" id="namaSkuoModal">

                    <!-- Custom Tabs UI -->
                    <div class="flex gap-2 mb-6 bg-gray-200/60 p-1.5 rounded-xl">
                        <button type="button" id="tabPraBtn" onclick="switchModalTab('pra')" class="flex-1 py-2.5 text-sm font-bold rounded-lg bg-white text-brand-blue shadow-sm transition-all border border-gray-200 flex items-center justify-center gap-2">
                            <i class="fa-regular fa-calendar-check text-brand-gold"></i> PRA KEGIATAN
                        </button>
                        <button type="button" id="tabPascaBtn" onclick="switchModalTab('pasca')" class="flex-1 py-2.5 text-sm font-bold rounded-lg text-gray-500 hover:text-brand-blue hover:bg-white/50 transition-all flex items-center justify-center gap-2">
                            <i class="fa-solid fa-flag-checkered"></i> PASCA KEGIATAN
                        </button>
                    </div>

                    <!-- TAB 1: PRA KEGIATAN -->
                    <div id="modalTabPra" class="space-y-6 animate-[fadeIn_0.3s_ease-out]">
                        
                        <!-- Reminder -->
                        <div class="bg-white p-5 rounded-xl border border-gray-200 shadow-sm">
                            <h4 class="text-sm font-bold text-gray-700 mb-4 flex items-center gap-2"><i class="fa-solid fa-bell text-brand-gold"></i> Reminder Kegiatan</h4>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                                <div>
                                    <label class="block text-xs font-bold text-gray-600 mb-1.5">Tanggal Reminder</label>
                                    <input type="date" id="pra_reminder_tgl" class="w-full rounded-lg border-gray-300 border px-3 py-2 focus:ring-2 focus:ring-brand-blue outline-none text-sm">
                                </div>
                                <div>
                                    <label class="block text-xs font-bold text-gray-600 mb-1.5">Screenshot Bukti (Gambar)</label>
                                    <input type="file" id="pra_reminder_file" accept="image/*" class="w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-brand-blue hover:file:bg-blue-100">
                                    <input type="hidden" id="pra_reminder_file_url">
                                    <div id="pra_reminder_link" class="mt-2 text-xs"></div>
                                </div>
                            </div>
                        </div>

                        <!-- SPP -->
                        <div class="bg-white p-5 rounded-xl border border-gray-200 shadow-sm">
                            <h4 class="text-sm font-bold text-gray-700 mb-4 flex items-center gap-2"><i class="fa-solid fa-file-invoice text-brand-gold"></i> Surat Permintaan Pelaksanaan (SPP)</h4>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                                <div>
                                    <label class="block text-xs font-bold text-gray-600 mb-1.5">Nomor SPP</label>
                                    <input type="text" id="pra_spp_no" placeholder="Contoh: 001/SPP/X/2026" class="w-full rounded-lg border-gray-300 border px-3 py-2 focus:ring-2 focus:ring-brand-blue outline-none text-sm">
                                </div>
                                <div>
                                    <label class="block text-xs font-bold text-gray-600 mb-1.5">Tanggal SPP</label>
                                    <input type="date" id="pra_spp_tgl" class="w-full rounded-lg border-gray-300 border px-3 py-2 focus:ring-2 focus:ring-brand-blue outline-none text-sm">
                                </div>
                            </div>
                        </div>

                        <!-- Koordinasi & Persuratan -->
                        <div class="bg-white p-5 rounded-xl border border-gray-200 shadow-sm">
                            <h4 class="text-sm font-bold text-gray-700 mb-4 flex items-center gap-2"><i class="fa-solid fa-handshake text-brand-gold"></i> Koordinasi & Persuratan</h4>
                            <div class="space-y-4">
                                <div>
                                    <label class="block text-xs font-bold text-gray-600 mb-2">Layanan Umum yang Terkoordinasi</label>
                                    <div id="layananUmumContainer" class="flex flex-wrap gap-3">
                                        <!-- Checkboxes injected by JS -->
                                    </div>
                                </div>
                                <div>
                                    <label class="block text-xs font-bold text-gray-600 mb-1.5">Catatan Persuratan</label>
                                    <textarea id="pra_persuratan" rows="2" placeholder="Tuliskan status persuratan jika ada..." class="w-full rounded-lg border-gray-300 border px-3 py-2 focus:ring-2 focus:ring-brand-blue outline-none text-sm resize-none"></textarea>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- TAB 2: PASCA KEGIATAN -->
                    <div id="modalTabPasca" class="hidden space-y-6 animate-[fadeIn_0.3s_ease-out]">
                        
                        <!-- Status -->
                        <div class="bg-white p-5 rounded-xl border-l-4 border-l-brand-blue shadow-sm">
                            <label class="block text-sm font-bold text-gray-700 mb-2">Status Akhir Kegiatan</label>
                            <select id="pasca_status" class="w-full md:w-1/2 rounded-lg border-gray-300 border px-3 py-2.5 focus:ring-2 focus:ring-brand-blue outline-none text-sm bg-gray-50 font-semibold">
                                <option value="">-- Pilih Status --</option>
                                <option value="Terlaksana">Terlaksana</option>
                                <option value="Dibatalkan">Dibatalkan</option>
                            </select>
                        </div>

                        <!-- Arsip LPJ -->
                        <div class="bg-white p-5 rounded-xl border border-gray-200 shadow-sm">
                            <h4 class="text-sm font-bold text-gray-700 mb-4 flex items-center gap-2"><i class="fa-solid fa-folder-open text-brand-gold"></i> Pengarsipan LPJ</h4>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                                <div>
                                    <label class="block text-xs font-bold text-gray-600 mb-1.5">Upload File LPJ (PDF)</label>
                                    <input type="file" id="pasca_lpj_file" accept=".pdf" class="w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-brand-blue hover:file:bg-blue-100">
                                    <input type="hidden" id="pasca_lpj_file_url">
                                    <div id="pasca_lpj_link_info" class="mt-2 text-xs"></div>
                                </div>
                                <div>
                                    <label class="block text-xs font-bold text-gray-600 mb-1.5">Link Kumpulan Arsip (Drive)</label>
                                    <input type="url" id="pasca_lpj_link" placeholder="https://drive.google.com/..." class="w-full rounded-lg border-gray-300 border px-3 py-2 focus:ring-2 focus:ring-brand-blue outline-none text-sm">
                                </div>
                                <div class="md:col-span-2">
                                    <input type="hidden" id="pasca_lpj_timestamp">
                                    <div id="lpj_timestamp_info" class="text-xs text-brand-blue bg-blue-50 p-2 rounded border border-blue-100 hidden"><i class="fa-regular fa-clock"></i> Timestamp: <span></span></div>
                                </div>
                            </div>
                        </div>

                        <!-- SPB -->
                        <div class="bg-white p-5 rounded-xl border border-gray-200 shadow-sm">
                            <h4 class="text-sm font-bold text-gray-700 mb-4 flex items-center gap-2"><i class="fa-solid fa-receipt text-brand-gold"></i> Surat Pertanggungjawaban Belanja (SPB)</h4>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                                <div>
                                    <label class="block text-xs font-bold text-gray-600 mb-1.5">Nomor SPB</label>
                                    <input type="text" id="pasca_spb_no" placeholder="Contoh: 001/SPB/X/2026" class="w-full rounded-lg border-gray-300 border px-3 py-2 focus:ring-2 focus:ring-brand-blue outline-none text-sm">
                                </div>
                                <div>
                                    <label class="block text-xs font-bold text-gray-600 mb-1.5">Tanggal SPB</label>
                                    <input type="date" id="pasca_spb_tgl" class="w-full rounded-lg border-gray-300 border px-3 py-2 focus:ring-2 focus:ring-brand-blue outline-none text-sm">
                                </div>
                            </div>
                        </div>

                    </div>
                </form>

            </div>
            
            <!-- Footer Modal -->
            <div class="p-5 border-t border-gray-200 bg-white flex justify-end gap-3 rounded-b-2xl">
                <button type="button" class="px-5 py-2.5 rounded-xl bg-gray-100 text-gray-700 font-bold hover:bg-gray-200 transition-colors text-sm" onclick="closeModal()">Tutup</button>
                <button type="button" class="px-6 py-2.5 rounded-xl bg-brand-blue text-white font-bold hover:bg-blue-800 shadow-md transition-all flex items-center gap-2 text-sm" onclick="saveKontrolData()"><i class="fa-solid fa-save"></i> Simpan Progress</button>
            </div>
        </div>
    </div>

    <script>
        // ==========================================
        // URL WEBAPP API GOOGLE APPS SCRIPT
        // ==========================================
        const API_URL = 'https://script.google.com/macros/s/AKfycbw2jUI_nr8ozuN2eo_UDX4m4RAQOZr6UrOA8bmcf1juOfdKRx2fqie3PFz7kjwzfjLJ/exec';

        // GLOBAL STATE
        let db = { akun: [], skuo: [], kegiatan: [], kontrol: [], config: [] };
        let currentUser = { wa: "", nama: "", listBidang: [] };
        let currentBidang = "";

        // --- FETCH WRAPPER (Mendukung Simulation Mode otomatis jika gagal/Canvas) ---
        async function fetchAPI(payload) {
            // Jika berjalan di Canvas (tidak ada google.script.run dan hostname lokal), gunakan mock data
            if (typeof google === 'undefined' && (window.location.hostname === '' || window.location.hostname === 'localhost' || window.location.hostname.includes('googleusercontent'))) {
                return simulateBackend(payload);
            }

            try {
                const response = await fetch(API_URL, {
                    method: 'POST',
                    headers: { 'Content-Type': 'text/plain;charset=utf-8' },
                    body: JSON.stringify(payload)
                });
                const result = await response.json();
                if (result.status === 'success') {
                    return result.data;
                } else {
                    throw new Error(result.message || "Gagal memproses permintaan.");
                }
            } catch (error) {
                console.warn("Fetch API gagal, menggunakan Mode Simulasi.", error);
                return simulateBackend(payload);
            }
        }

        // --- SIMULATION BACKEND (Khusus untuk tampilan Canvas/Preview) ---
        function simulateBackend(payload) {
            return new Promise((resolve) => {
                setTimeout(() => {
                    if (payload.action === 'getAllData') {
                        resolve({
                            akun: [
                                { id: "U1", no_wa: "6281234567890", nama: "Admin Canvas", bidang_kerja: "Keuangan,Operasional" }
                            ],
                            skuo: [
                                { id: "SK-1", bidang_kerja: "Keuangan", nama_skuo: "Penyusunan Anggaran" },
                                { id: "SK-2", bidang_kerja: "Keuangan", nama_skuo: "Audit Internal" },
                                { id: "SK-3", bidang_kerja: "Operasional", nama_skuo: "Maintenance" }
                            ],
                            kegiatan: [
                                { id: "K-1", no_wa: "628123", nama: "Admin", bidang_kerja: "Keuangan", nama_kegiatan: "RAPAT TAHUNAN", skuo: "Penyusunan Anggaran", tanggal: "15/10/2026", mode: "Offline" },
                                { id: "K-2", no_wa: "628123", nama: "Admin", bidang_kerja: "Keuangan", nama_kegiatan: "AUDIT CABANG", skuo: "Audit Internal", tanggal: "20/10/2026", mode: "Online" }
                            ],
                            kontrol: db.kontrol || [],
                            config: [
                                { kategori: "Layanan_Umum", nilai: "Konsumsi" },
                                { kategori: "Layanan_Umum", nilai: "Peminjaman Ruangan" },
                                { kategori: "Layanan_Umum", nilai: "Sound System" }
                            ]
                        });
                    } else if (payload.action === 'saveKontrolData') {
                        let existingIdx = db.kontrol.findIndex(k => k.id_kegiatan === payload.data.id_kegiatan);
                        let newData = { ...payload.data };
                        if(newData.pasca_lpj_file_base64 || newData.pasca_lpj_link) newData.pasca_lpj_timestamp = new Date().toLocaleString();
                        
                        if (existingIdx > -1) db.kontrol[existingIdx] = newData;
                        else db.kontrol.push(newData);
                        resolve(db);
                    }
                }, 800);
            });
        }

        // --- CORE SYSTEM & LOADING ---
        let loadInterval;
        let loadProgress = 0;

        function startLoading(text = "Memuat Sistem...") {
            document.getElementById('loadingText').innerHTML = `${text} <span id="loadingPercent">0%</span>`;
            document.getElementById('loadingOverlay').style.display = 'flex';
            setTimeout(() => { document.getElementById('loadingOverlay').style.opacity = '1'; }, 10);
            
            loadProgress = 0;
            clearInterval(loadInterval);
            loadInterval = setInterval(() => {
                loadProgress += Math.floor(Math.random() * 15) + 5;
                if (loadProgress > 95) loadProgress = 95;
                const pct = document.getElementById('loadingPercent');
                if(pct) pct.innerText = loadProgress + '%';
            }, 100);
        }

        function endLoading() {
            const pct = document.getElementById('loadingPercent');
            if(pct) pct.innerText = '100%';
            clearInterval(loadInterval);
            setTimeout(() => {
                document.getElementById('loadingOverlay').style.opacity = '0';
                setTimeout(() => { document.getElementById('loadingOverlay').style.display = 'none'; }, 300);
            }, 300);
        }

        async function initSystem() {
            try {
                startLoading("Mengambil data sistem...");
                db = await fetchAPI({ action: 'getAllData' });
                
                document.getElementById('headerLogo').classList.remove('hidden');
                document.getElementById('loginView').classList.remove('hidden');
                
                // Render Checkboxes Layanan Umum
                const container = document.getElementById('layananUmumContainer');
                container.innerHTML = '';
                const layananList = db.config.filter(c => c.kategori === 'Layanan_Umum');
                layananList.forEach((item, i) => {
                    container.innerHTML += `
                        <label class="inline-flex items-center bg-gray-50 border border-gray-200 px-3 py-1.5 rounded-lg cursor-pointer hover:bg-gray-100 transition-colors">
                            <input type="checkbox" class="chk-layanan w-4 h-4 text-brand-blue border-gray-300 rounded focus:ring-brand-blue" value="${item.nilai}" id="chkLU_${i}">
                            <span class="ml-2 text-xs font-medium text-gray-700">${item.nilai}</span>
                        </label>
                    `;
                });

                endLoading();
            } catch (error) {
                endLoading();
                Swal.fire('Koneksi Gagal', 'Tidak dapat terhubung ke server.', 'error');
            }
        }

        // --- FORMATTING HELPERS ---
        function formatWA(input) {
            let val = input.value.replace(/\D/g, ''); 
            if (val.startsWith('08')) val = '628' + val.substring(2); 
            input.value = val;
        }

        function formatToInputDate(dateStr) {
            if(!dateStr) return "";
            if(dateStr.includes('-')) return dateStr; // Already yyyy-mm-dd
            const parts = dateStr.split('/');
            if(parts.length !== 3) return dateStr;
            const d = parts[0].padStart(2, '0');
            const m = parts[1].padStart(2, '0');
            return `${parts[2]}-${m}-${d}`;
        }

        // --- AUTH & NAVIGATION ---
        function handleLogin(e) {
            e.preventDefault();
            const wa = document.getElementById('loginWa').value;
            const userAccount = db.akun.find(a => a.no_wa == wa);
            
            if (!userAccount) {
                Swal.fire('Akses Ditolak', 'Nomor WhatsApp tidak terdaftar.', 'error');
                return;
            }

            currentUser.wa = wa;
            currentUser.nama = userAccount.nama;
            currentUser.listBidang = userAccount.bidang_kerja.split(',').map(b => b.trim());

            if (currentUser.listBidang.length === 1) {
                enterApp(currentUser.listBidang[0]);
            } else {
                document.getElementById('loginView').classList.add('hidden');
                document.getElementById('pilihBidangView').classList.remove('hidden');
                document.getElementById('welcomePilihBidang').innerText = `Selamat datang, ${currentUser.nama}. Pilih akses Anda:`;
                
                const listDiv = document.getElementById('listBidang');
                listDiv.innerHTML = '';
                currentUser.listBidang.forEach(bidang => {
                    listDiv.innerHTML += `
                        <button onclick="enterApp('${bidang}')" class="w-full text-left bg-white border border-gray-200 hover:border-brand-blue hover:shadow-md p-4 rounded-xl transition-all flex items-center justify-between group">
                            <div>
                                <p class="text-xs text-gray-500 mb-0.5">Akses sebagai SBK</p>
                                <p class="font-bold text-brand-blue">${bidang}</p>
                            </div>
                            <i class="fa-solid fa-chevron-right text-gray-300 group-hover:text-brand-gold"></i>
                        </button>
                    `;
                });
            }
        }

        function enterApp(bidang) {
            currentBidang = bidang;
            
            document.getElementById('loginView').classList.add('hidden');
            document.getElementById('pilihBidangView').classList.add('hidden');
            document.getElementById('mainAppView').classList.remove('hidden');
            
            document.getElementById('infoNama').innerText = currentUser.nama;
            document.getElementById('infoBidang').innerText = currentBidang;

            if (currentUser.listBidang.length > 1) {
                document.getElementById('btnSwitchRole').classList.remove('hidden');
            }
            
            renderTable();
        }

        function switchRole() {
            document.getElementById('mainAppView').classList.add('hidden');
            document.getElementById('pilihBidangView').classList.remove('hidden');
        }

        function logout() {
            currentUser = { wa: "", nama: "", listBidang: [] };
            currentBidang = "";
            document.getElementById('loginWa').value = "";
            document.getElementById('mainAppView').classList.add('hidden');
            document.getElementById('pilihBidangView').classList.add('hidden');
            document.getElementById('loginView').classList.remove('hidden');
        }

        // --- TABLE LOGIC ---
        function renderTable() {
            const tbody = document.getElementById('tableBody');
            tbody.innerHTML = '';
            
            // Filter kegiatan berdasarkan Bidang Kerja yang dipilih
            let myKegiatan = db.kegiatan.filter(k => k.bidang_kerja === currentBidang);
            
            if (myKegiatan.length === 0) {
                tbody.innerHTML = `<tr><td colspan="5" class="text-center py-8 text-gray-500 italic">Belum ada data kegiatan untuk bidang ini.</td></tr>`;
                return;
            }

            myKegiatan.forEach((keg, index) => {
                const kontrol = db.kontrol.find(c => c.id_kegiatan === keg.id);
                let statusBadge = '<span class="bg-gray-100 text-gray-600 border border-gray-200 px-2 py-1 rounded text-[10px] font-bold uppercase">Belum Diisi</span>';
                
                if (kontrol) {
                    if (kontrol.pasca_status === 'Terlaksana') statusBadge = '<span class="bg-green-50 text-green-700 border border-green-200 px-2 py-1 rounded text-[10px] font-bold uppercase">Terlaksana</span>';
                    else if (kontrol.pasca_status === 'Dibatalkan') statusBadge = '<span class="bg-red-50 text-red-700 border border-red-200 px-2 py-1 rounded text-[10px] font-bold uppercase">Dibatalkan</span>';
                    else statusBadge = '<span class="bg-yellow-50 text-yellow-700 border border-yellow-200 px-2 py-1 rounded text-[10px] font-bold uppercase">Diproses</span>';
                }

                tbody.innerHTML += `
                    <tr class="hover:bg-blue-50/40 transition-colors">
                        <td class="px-4 py-3 text-center text-gray-500 text-xs">${index + 1}</td>
                        <td class="px-4 py-3 font-bold text-brand-blue text-sm">
                            ${keg.nama_kegiatan}
                            <div class="text-[10px] text-gray-400 font-normal mt-0.5"><i class="fa-solid fa-layer-group"></i> ${keg.skuo}</div>
                        </td>
                        <td class="px-4 py-3 text-gray-700 text-xs">${keg.tanggal}</td>
                        <td class="px-4 py-3">${statusBadge}</td>
                        <td class="px-4 py-3 text-center">
                            <button class="bg-brand-blue hover:bg-blue-800 text-white px-3 py-1.5 rounded shadow-sm text-xs font-semibold transition-colors flex items-center gap-1 mx-auto" onclick="openModal('${keg.id}')">
                                <i class="fa-solid fa-pen-to-square"></i> Kontrol
                            </button>
                        </td>
                    </tr>
                `;
            });
        }

        function filterTableUI() {
            const input = document.getElementById("searchTable").value.toLowerCase();
            const rows = document.getElementById("tableBody").getElementsByTagName("tr");
            
            for (let i = 0; i < rows.length; i++) {
                if (rows[i].cells.length > 1) { 
                    const text = rows[i].textContent.toLowerCase();
                    rows[i].style.display = text.includes(input) ? "" : "none";
                }
            }
        }

        // --- MODAL & FORM KONTROL LOGIC ---
        function switchModalTab(tab) {
            if (tab === 'pra') {
                document.getElementById('modalTabPra').classList.remove('hidden');
                document.getElementById('modalTabPasca').classList.add('hidden');
                document.getElementById('tabPraBtn').className = "flex-1 py-2.5 text-sm font-bold rounded-lg bg-white text-brand-blue shadow-sm transition-all border border-gray-200 flex items-center justify-center gap-2";
                document.getElementById('tabPascaBtn').className = "flex-1 py-2.5 text-sm font-bold rounded-lg text-gray-500 hover:text-brand-blue hover:bg-white/50 transition-all flex items-center justify-center gap-2";
            } else {
                document.getElementById('modalTabPra').classList.add('hidden');
                document.getElementById('modalTabPasca').classList.remove('hidden');
                document.getElementById('tabPraBtn').className = "flex-1 py-2.5 text-sm font-bold rounded-lg text-gray-500 hover:text-brand-blue hover:bg-white/50 transition-all flex items-center justify-center gap-2";
                document.getElementById('tabPascaBtn').className = "flex-1 py-2.5 text-sm font-bold rounded-lg bg-white text-brand-blue shadow-sm transition-all border border-gray-200 flex items-center justify-center gap-2";
            }
        }

        function openModal(idKegiatan) {
            const keg = db.kegiatan.find(k => k.id === idKegiatan);
            document.getElementById('modalSubtitle').innerText = `${keg.nama_kegiatan} (${keg.tanggal})`;
            
            document.getElementById('idKegiatan').value = idKegiatan;
            document.getElementById('namaKegiatanModal').value = keg.nama_kegiatan;
            document.getElementById('namaSkuoModal').value = keg.skuo;
            
            document.getElementById('formKontrol').reset();
            
            // Reset state
            document.querySelectorAll('.chk-layanan').forEach(chk => chk.checked = false);
            document.getElementById('pra_reminder_file_url').value = '';
            document.getElementById('pra_reminder_link').innerHTML = '';
            document.getElementById('pasca_lpj_file_url').value = '';
            document.getElementById('pasca_lpj_link_info').innerHTML = '';
            document.getElementById('pasca_lpj_timestamp').value = '';
            document.getElementById('lpj_timestamp_info').classList.add('hidden');

            // Cek Data Exists
            const data = db.kontrol.find(c => c.id_kegiatan === idKegiatan);
            if (data) {
                // Pra
                if(data.pra_reminder_tgl) document.getElementById('pra_reminder_tgl').value = formatToInputDate(data.pra_reminder_tgl);
                if(data.pra_spp_no) document.getElementById('pra_spp_no').value = data.pra_spp_no;
                if(data.pra_spp_tgl) document.getElementById('pra_spp_tgl').value = formatToInputDate(data.pra_spp_tgl);
                if(data.pra_persuratan) document.getElementById('pra_persuratan').value = data.pra_persuratan;
                
                if(data.pra_reminder_file) {
                    document.getElementById('pra_reminder_file_url').value = data.pra_reminder_file;
                    document.getElementById('pra_reminder_link').innerHTML = `<a href="${data.pra_reminder_file}" target="_blank" class="text-blue-600 hover:underline"><i class="fa-solid fa-arrow-up-right-from-square"></i> Lihat Bukti Tersimpan</a>`;
                }

                if(data.pra_layanan_umum) {
                    const selected = data.pra_layanan_umum.split(',');
                    document.querySelectorAll('.chk-layanan').forEach(chk => {
                        if (selected.includes(chk.value)) chk.checked = true;
                    });
                }

                // Pasca
                if(data.pasca_status) document.getElementById('pasca_status').value = data.pasca_status;
                if(data.pasca_lpj_link) document.getElementById('pasca_lpj_link').value = data.pasca_lpj_link;
                if(data.pasca_spb_no) document.getElementById('pasca_spb_no').value = data.pasca_spb_no;
                if(data.pasca_spb_tgl) document.getElementById('pasca_spb_tgl').value = formatToInputDate(data.pasca_spb_tgl);
                
                if(data.pasca_lpj_timestamp) {
                    document.getElementById('pasca_lpj_timestamp').value = data.pasca_lpj_timestamp;
                    document.getElementById('lpj_timestamp_info').classList.remove('hidden');
                    document.getElementById('lpj_timestamp_info').querySelector('span').innerText = data.pasca_lpj_timestamp;
                }

                if(data.pasca_lpj_file) {
                    document.getElementById('pasca_lpj_file_url').value = data.pasca_lpj_file;
                    document.getElementById('pasca_lpj_link_info').innerHTML = `<a href="${data.pasca_lpj_file}" target="_blank" class="text-blue-600 hover:underline"><i class="fa-solid fa-arrow-up-right-from-square"></i> Lihat PDF Tersimpan</a>`;
                }
            }
            
            switchModalTab('pra');
            
            const modal = document.getElementById('modalKontrol');
            const modalContent = document.getElementById('modalKontrolContent');
            modal.classList.remove('hidden');
            setTimeout(() => {
                modalContent.classList.remove('scale-95');
                modalContent.classList.add('scale-100');
            }, 10);
        }

        function closeModal() {
            const modal = document.getElementById('modalKontrol');
            const modalContent = document.getElementById('modalKontrolContent');
            modalContent.classList.remove('scale-100');
            modalContent.classList.add('scale-95');
            setTimeout(() => { modal.classList.add('hidden'); }, 300);
        }

        const getBase64 = (file) => new Promise((resolve, reject) => {
            const reader = new FileReader();
            reader.readAsDataURL(file);
            reader.onload = () => resolve(reader.result);
            reader.onerror = error => reject(error);
        });

        async function saveKontrolData() {
            // Cek Checkbox Layanan
            let layananUmumArr = [];
            document.querySelectorAll('.chk-layanan:checked').forEach(chk => layananUmumArr.push(chk.value));

            let payload = {
                id_kegiatan: document.getElementById('idKegiatan').value,
                nama_kegiatan: document.getElementById('namaKegiatanModal').value,
                skuo_nama: document.getElementById('namaSkuoModal').value,
                
                pra_reminder_tgl: document.getElementById('pra_reminder_tgl').value,
                pra_reminder_file_url: document.getElementById('pra_reminder_file_url').value,
                pra_spp_no: document.getElementById('pra_spp_no').value,
                pra_spp_tgl: document.getElementById('pra_spp_tgl').value,
                pra_layanan_umum: layananUmumArr.join(','),
                pra_persuratan: document.getElementById('pra_persuratan').value,
                
                pasca_status: document.getElementById('pasca_status').value,
                pasca_lpj_file_url: document.getElementById('pasca_lpj_file_url').value,
                pasca_lpj_link: document.getElementById('pasca_lpj_link').value,
                pasca_lpj_timestamp: document.getElementById('pasca_lpj_timestamp').value,
                pasca_spb_no: document.getElementById('pasca_spb_no').value,
                pasca_spb_tgl: document.getElementById('pasca_spb_tgl').value
            };

            startLoading("Memproses File & Menyimpan Data...");

            try {
                const fileReminder = document.getElementById('pra_reminder_file').files[0];
                if (fileReminder) {
                    payload.pra_reminder_file_base64 = await getBase64(fileReminder);
                    payload.pra_reminder_file_name = fileReminder.name;
                }

                const fileLpj = document.getElementById('pasca_lpj_file').files[0];
                if (fileLpj) {
                    payload.pasca_lpj_file_base64 = await getBase64(fileLpj);
                    payload.pasca_lpj_file_name = fileLpj.name;
                }

                db = await fetchAPI({ action: 'saveKontrolData', data: payload });
                
                closeModal();
                renderTable();
                endLoading();
                Swal.fire({ icon: 'success', title: 'Berhasil', text: 'Data kontrol berhasil diupdate.', timer: 2000, showConfirmButton: false });
            } catch (error) {
                endLoading();
                Swal.fire('Error', 'Gagal menyimpan data ke server.', 'error');
            }
        }
    </script>
</body>
